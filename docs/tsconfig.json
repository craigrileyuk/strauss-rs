{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"noUncheckedSideEffectImports": true
	},
	"include": [".vitepress/**/*.ts"],
	"exclude": [".vitepress/cache", ".vitepress/dist", "node_modules"]
}
